# Root .gitignore for UAV ID project

# Dependency directories
node_modules/
**/node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage
.nyc_output

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# System files
Thumbs.db
desktop.ini

# OS metadata
.DS_Store
.AppleDouble
.LSOverride

# tài khoản.txt

# Environment variables
# USER REQUESTED TO KEEP .ENV FILES
!**/.env
!.env
